{
  "name": "@intraverse/se-client-reference-game",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal sandboxed game for tests and as a sample.",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsdown",
      "files": [
        "src/**",
        "!src/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "tsdown.config.ts",
        "../../tsdown.base.ts",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "files": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  }
}
