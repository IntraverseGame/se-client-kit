{
  "name": "@intraverse/se-client-reference-game",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal steps game (Coin Flip, Cash or Crash) for the tests and as a sample for game developers.",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "env": {
        "NODE_ENV": {
          "external": true
        }
      },
      "files": [
        "index.html",
        "public/**",
        "src/**",
        "!src/**/*.test.ts",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "postcss.config.*",
        ".postcssrc",
        ".postcssrc.*",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        ".env",
        ".env.*"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted",
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "typecheck": {
      "command": "tsx ../../tools/check-kit-dist.ts typecheck && tsc -p tsconfig.json",
      "files": [
        "index.html",
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../tools/check-kit-dist.ts",
        "../../tools/kit-dist.ts",
        "../../tools/kit-dist-fs.ts"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../../packages/shell:build"
      ]
    },
    "test": {
      "command": "vitest run",
      "files": [
        "index.html",
        "public/**",
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        ".env",
        ".env.*"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  },
  "devDependencies": {
    "@intraverse/se-client-shell": "workspace:*",
    "vite": "8.3.4"
  }
}
