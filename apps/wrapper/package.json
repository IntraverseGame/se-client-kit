{
  "name": "@intraverse/se-client-wrapper",
  "version": "0.0.0",
  "private": true,
  "description": "The Wrapper UI, built by Vite into a release bundle.",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "vite build",
      "files": [
        "index.html",
        "public/**",
        "src/**",
        "!src/**/*.test.ts",
        "!src/fixtures/guard-scratch.ts",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "postcss.config.*",
        ".postcssrc",
        ".postcssrc.*",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        ".env",
        ".env.*"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted",
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../../packages/shell:build"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "files": [
        "index.html",
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../../packages/shell:build"
      ]
    },
    "test": {
      "command": "vitest run",
      "files": [
        "index.html",
        "public/**",
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        ".env",
        ".env.*"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../../packages/shell:build",
        "../../packages/contracts:build"
      ]
    }
  },
  "devDependencies": {
    "vite": "8.3.4"
  }
}
