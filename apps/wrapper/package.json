{
  "name": "@intraverse/se-client-wrapper",
  "version": "0.0.0",
  "private": true,
  "description": "The Wrapper UI, built by Vite into a release bundle.",
  "type": "module",
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsx ../../tools/check-kit-dist.ts build && vite build",
      "env": {
        "NODE_ENV": {
          "external": true
        }
      },
      "files": [
        "index.html",
        "public/**",
        "src/**",
        "!src/**/*.test.ts",
        "!src/fixtures/guard-scratch.ts",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "postcss.config.*",
        ".postcssrc",
        ".postcssrc.*",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        ".env",
        ".env.*",
        "../../tools/check-kit-dist.ts",
        "../../tools/kit-dist.ts",
        "../../tools/kit-dist-fs.ts",
        "../../tools/test-only-entry-guard.ts",
        "../../tools/guard-text.ts"
      ],
      "output": [
        "dist/**"
      ],
      "clean": "if-file-deleted",
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../../packages/shell:build",
        "../verify:build"
      ]
    },
    "typecheck": {
      "command": "tsx ../../tools/check-kit-dist.ts typecheck && tsc -p tsconfig.json",
      "files": [
        "index.html",
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../tools/check-kit-dist.ts",
        "../../tools/kit-dist.ts",
        "../../tools/kit-dist-fs.ts",
        "../../tools/test-only-entry-guard.ts",
        "../../tools/guard-text.ts"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../../packages/shell:build",
        "../../packages/contracts:build"
      ]
    },
    "test": {
      "command": "tsx ../../tools/check-kit-dist.ts test && vitest run",
      "files": [
        "index.html",
        "public/**",
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../package.json",
        "../../pnpm-workspace.yaml",
        ".env",
        ".env.*",
        "../../tools/check-kit-dist.ts",
        "../../tools/kit-dist.ts",
        "../../tools/kit-dist-fs.ts",
        "../../tools/test-only-entry-guard.ts",
        "../../tools/guard-text.ts"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../../packages/shell:build",
        "../../packages/contracts:build"
      ]
    }
  },
  "dependencies": {
    "@intraverse/se-client-shell": "workspace:*"
  },
  "devDependencies": {
    "@intraverse/se-client-contracts": "workspace:*",
    "vite": "8.3.4"
  }
}
