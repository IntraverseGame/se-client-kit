{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "insertFinalNewline": true,
  "jsdoc": true,
  "proseWrap": "always",
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "tabWidth": 2,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "singleAttributePerLine": true,
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/.wireit/**",
    "**/node_modules/**",
    "**/CHANGELOG.md",
    ".changeset/**/*.md",
    "pnpm-lock.*",
    "LICENSE",
    // Vendored from the backend, byte for byte: the lock file pins their
    // SHA-256, so a formatter must never rewrite them.
    "packages/contracts/src/schemas/**/*.json",
    "packages/contracts/src/schemas/**/*.yaml",
    "packages/contracts/src/vectors/**/*.json",
    // Recorded verify API responses of the e2e suite, kept as recorded (see
    // the README beside them); a formatter must never rewrite them.
    "e2e/tests/harness/recorded-rounds/*.json",
    // Generated by tools/generate-contracts.ts, which `check:contracts` proves
    // current; a formatter would make the output differ from the generator's.
    "packages/contracts/src/generated/**",
    "packages/contracts/src/vectors/catalog.ts",
    // Agent and skill files keep single-line frontmatter descriptions, which
    // some agent tools require; oxfmt would wrap them. The memories and the
    // templates the agent and skill files are copied from have the same
    // frontmatter.
    ".ai/agents/*.md",
    ".ai/skills/*/SKILL.md",
    ".ai/memories/*.md",
    ".ai/memories/working/*.md",
    ".ai/templates/*.md"
  ]
}
