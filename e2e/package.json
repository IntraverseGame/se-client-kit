{
  "name": "@intraverse/se-client-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright suite and the fake Play API.",
  "type": "module",
  "scripts": {
    "test": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "test": {
      "command": "playwright test",
      "dependencies": [
        "../apps/wrapper:build",
        "../apps/reference-game:build",
        "../packages/contracts:build"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "files": [
        "*.ts",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "../tsconfig.base.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../packages/contracts:build"
      ]
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@intraverse/se-client-contracts": "workspace:*",
    "@playwright/test": "1.64.0"
  }
}
