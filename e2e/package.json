{
  "name": "@intraverse/se-client-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright suite and the fake Play API.",
  "type": "module",
  "scripts": {
    "test": "wireit",
    "test:preview": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "test": {
      "command": "tsx ../tools/check-kit-dist.ts test ../apps/wrapper/dist/index.html ../apps/reference-game/dist/index.html && playwright test --project=\"${SE_E2E_PROJECT:-chromium}\"",
      "env": {
        "SE_E2E_PROJECT": {
          "external": true
        },
        "SE_E2E_BROWSER_CHANNEL": {
          "external": true
        },
        "CI": {
          "external": true
        }
      },
      "dependencies": [
        "../apps/wrapper:build",
        "../apps/reference-game:build",
        "../packages/contracts:build"
      ]
    },
    "test:preview": {
      "command": "tsx ../tools/check-kit-dist.ts test:preview ../apps/wrapper/dist/index.html ../apps/reference-game/dist/index.html && tsx ./tests/preview-support/run-preview.ts",
      "env": {
        "SE_E2E_PREVIEW_ORIGIN": {
          "external": true
        },
        "SE_E2E_PREVIEW_LAUNCH_COMMAND": {
          "external": true
        },
        "SE_E2E_PREVIEW_GAME_ORIGIN": {
          "external": true
        },
        "SE_E2E_PREVIEW_ALLOWED_ORIGINS": {
          "external": true
        },
        "SE_E2E_BROWSER_CHANNEL": {
          "external": true
        },
        "CI": {
          "external": true
        }
      },
      "dependencies": [
        "../apps/wrapper:build",
        "../apps/reference-game:build",
        "../packages/contracts:build"
      ]
    },
    "typecheck": {
      "command": "tsx ../tools/check-kit-dist.ts typecheck && tsc -p tsconfig.json",
      "files": [
        "*.ts",
        "tests/**",
        "package.json",
        "tsconfig.json",
        "../tsconfig.base.json",
        "../tools/check-kit-dist.ts",
        "../tools/kit-dist.ts",
        "../tools/kit-dist-fs.ts"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ],
      "dependencies": [
        "../packages/contracts:build"
      ]
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@intraverse/se-client-contracts": "workspace:*",
    "@playwright/test": "1.64.1"
  }
}
