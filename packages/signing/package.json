{
  "name": "@intraverse/se-client-signing",
  "version": "0.0.0",
  "private": true,
  "description": "EIP-712 and secp256k1 signing for SuperEngine's signed actions, with canonical 65-byte signatures.",
  "keywords": [
    "superengine",
    "eip-712",
    "secp256k1",
    "signing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntraverseGame/se-client-kit.git",
    "directory": "packages/signing"
  },
  "bugs": {
    "url": "https://github.com/IntraverseGame/se-client-kit/issues"
  },
  "homepage": "https://github.com/IntraverseGame/se-client-kit/tree/main/packages/signing#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsdown",
      "files": [
        "src/**",
        "!src/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "tsdown.config.ts",
        "../../tsdown.base.ts",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "typecheck": {
      "command": "tsx ../../tools/check-kit-dist.ts typecheck && tsc -p tsconfig.json && tsc -p tsconfig.test.json",
      "dependencies": [
        "../contracts:build"
      ],
      "files": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "../../tsconfig.base.json",
        "../../tools/check-kit-dist.ts",
        "../../tools/kit-dist.ts",
        "../../tools/kit-dist-fs.ts"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "test": {
      "command": "tsx ../../tools/check-kit-dist.ts test && vitest run",
      "dependencies": [
        "../contracts:build"
      ],
      "files": [
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "../../tsconfig.base.json",
        "../../tsdown.base.ts",
        "../../tools/check-kit-dist.ts",
        "../../tools/kit-dist.ts",
        "../../tools/kit-dist-fs.ts"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@intraverse/se-client-contracts": "workspace:*"
  }
}
