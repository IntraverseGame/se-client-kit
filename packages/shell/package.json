{
  "name": "@intraverse/se-client-shell",
  "version": "0.0.0",
  "private": true,
  "description": "The headless part of the SuperEngine Wrapper: sessions, key custody, and the game boundary.",
  "keywords": [
    "superengine",
    "wrapper",
    "key-custody",
    "headless"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntraverseGame/se-client-kit.git",
    "directory": "packages/shell"
  },
  "bugs": {
    "url": "https://github.com/IntraverseGame/se-client-kit/issues"
  },
  "homepage": "https://github.com/IntraverseGame/se-client-kit/tree/main/packages/shell#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./controller": {
      "types": "./dist/controller.d.ts"
    }
  },
  "dependencies": {
    "@intraverse/se-client-play-client": "workspace:*",
    "@intraverse/se-client-signing": "workspace:*",
    "@intraverse/se-client-snapshot": "workspace:*"
  },
  "scripts": {
    "build": "wireit",
    "typecheck": "wireit",
    "test": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsdown",
      "dependencies": [
        "../signing:build",
        "../snapshot:build",
        "../play-client:build"
      ],
      "files": [
        "src/**",
        "!src/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "tsdown.config.ts",
        "../../tsdown.base.ts",
        "../../tsconfig.base.json"
      ],
      "output": [
        "dist/**"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
      "dependencies": [
        "../signing:build",
        "../snapshot:build",
        "../play-client:build",
        "../contracts:build"
      ],
      "files": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "../../tsconfig.base.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "../signing:build",
        "../snapshot:build",
        "../play-client:build",
        "../contracts:build"
      ],
      "files": [
        "src/**",
        "*.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.test.json",
        "../../tsdown.base.ts",
        "../../tsconfig.base.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  },
  "devDependencies": {
    "@intraverse/se-client-contracts": "workspace:*"
  }
}
