{
  "set": "kernel/public/v1/coin-flip-payout",
  "kernelVersion": 1,
  "spec": "SuperEngine fairness kernel, kernelVersion 1: Coin Flip payout",
  "description": "Schedule(terms, path, bet) for Coin Flip: the terms are one node {\"options\": 2, \"losers\": 1, \"next\": []}, a houseEdgeWad (WAD = 10^18) and a maxMultiplierMilli cap (1000 = 1x); the path is [0]. Checks, in order: houseEdgeWad < WAD (else house-edge-out-of-range); maxMultiplierMilli >= 1 (else max-multiplier-out-of-range); then 1 <= bet <= 2^128 - 1 (else bet-out-of-range); then the payout is at most 2^128 - 1 (else payout-too-large). m_1 = floor(1000 * (WAD - houseEdgeWad) * 2 / WAD); the one step reports node 0, multiplierMilli = min(m_1, maxMultiplierMilli), payout = floor(bet * multiplierMilli / 1000), and rtp = payout / bet * 1/2 as a reduced fraction numerator/denominator",
  "vectors": [
    {
      "vector": "kernel/public/v1/coin-flip-payout/b1000000",
      "description": "Coin Flip, rho 0.97, B = 1,000,000: m_1 = 1940, RTP exactly 97/100",
      "input": {
        "terms": {
          "nodes": [
            { "options": 2, "losers": 1, "next": [] }
          ],
          "houseEdgeWad": "30000000000000000",
          "maxMultiplierMilli": 4294967295
        },
        "path": [0],
        "bet": "1000000"
      },
      "expected": {
        "steps": [
          {
            "node": 0,
            "multiplierMilli": "1940",
            "payout": "1940000",
            "rtp": "97/100"
          }
        ]
      }
    },
    {
      "vector": "kernel/public/v1/coin-flip-payout/b1",
