      "maxLength": 78
    },
    "ZKProofRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "processing", "verified", "failed"] },
        "proofRef": { "$ref": "#/$defs/Hash32" },
        "verifiedBy": { "enum": ["superengine", "zkverify", "onchain"] },
        "txHash": { "$ref": "#/$defs/Hash32" },
        "proofLink": { "$ref": "#/$defs/HttpsUrl" }
      },
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": { "required": ["verifiedBy", "proofRef"] },
      "else": {
        "not": { "anyOf": [{ "required": ["verifiedBy"] }, { "required": ["txHash"] }, { "required": ["proofLink"] }] }
      }
    },
    "ErrorCode": {
      "enum": [
        "INSUFFICIENT_FUNDS",
        "LIMIT_EXCEEDED",
        "PLAYER_RESTRICTED",
        "FUNDING_UNCONFIRMED",
        "ENTROPY_UNAVAILABLE",
        "PREPARATION_TIMEOUT",
        "SIGNED_START_FAILED",
        "LANE_LIMIT",
        "ROUND_VOIDED",
        "ROUND_ACTIVE",
        "SESSION_EXPIRED",
        "SESSION_REVOKED",
        "STALE_ACTION",
        "INVALID_ARGUMENT",
        "NOT_FOUND",
        "CONFLICT",
        "FAILED_PRECONDITION",
        "UNAUTHENTICATED",
        "PERMISSION_DENIED",
        "UNAVAILABLE",
        "UNIMPLEMENTED",
        "INTERNAL",
        "UNKNOWN"
      ]
    },
    "PlayProblem": {
      "description": "Play API error: RFC 9457 problem+json plus a typed code and retryable flag.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "status", "code", "retryable"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "detail": { "type": "string" },
        "instance": { "type": "string" },
        "requestId": { "type": "string" },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "retryable": { "type": "boolean" },
        "snapshot": { "description": "ROUND_ACTIVE only: the open round, so the client can resume it.", "$ref": "#" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": { "enum": ["FUNDING_UNCONFIRMED", "ENTROPY_UNAVAILABLE", "PREPARATION_TIMEOUT", "LANE_LIMIT", "ROUND_VOIDED", "UNAVAILABLE"] }
            }
          },
          "then": {
            "$comment": "UNAVAILABLE is retryable by default but may be false: a call that is never repeated (sessions:redeem) sends false. Every other code of the list stays pinned to true.",
            "if": { "properties": { "code": { "const": "UNAVAILABLE" } } },
            "else": { "properties": { "retryable": { "const": true } } }
          },
          "else": { "properties": { "retryable": { "const": false } } }
        },
        {
          "if": { "properties": { "code": { "const": "ROUND_ACTIVE" } } },
          "then": { "required": ["snapshot"] },
          "else": { "not": { "required": ["snapshot"] } }
        }
      ]
    }
  }
}
