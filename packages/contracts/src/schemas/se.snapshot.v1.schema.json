{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:superengine:schema:se.snapshot:1",
  "title": "Snapshot",
  "description": "se.snapshot/1: the one document every game client renders. Closed objects everywhere: a field that is not listed here can never be served (an allow-list).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "presentation", "model", "context", "status", "bet", "config"],
  "properties": {
    "schema": { "const": "se.snapshot/1" },
    "version": {
      "description": "Per-session, monotonically increasing Snapshot counter. Not the schema version.",
      "type": "integer",
      "minimum": 0
    },
    "presentation": {
      "description": "Client contract the game renders: steps (StepConfig) or playback (BookConfig). One per session: a session plays one game version, so presentation, config.kind and config.model never change across its Snapshots; a client may treat a change as a verification failure.",
      "enum": ["steps", "playback"]
    },
    "model": {
      "description": "Game model behind the round. Informational; the client branches on presentation.",
      "enum": ["config", "book"]
    },
    "context": { "$ref": "#/$defs/SessionContext" },
    "status": { "$ref": "#/$defs/RoundStatus" },
    "closeReason": {
      "description": "Why a terminal round closed, when it did not close by play. Shown next to status, never a status of its own.",
      "enum": ["expired"]
    },
    "roundId": { "$ref": "#/$defs/RoundId" },
    "bet": { "$ref": "#/$defs/BetContext" },
    "step": {
      "description": "Progress through the round: 0 .. steps.length (steps presentation only).",
      "type": "integer",
      "minimum": 0
    },
    "currentMultiplier": { "$ref": "#/$defs/Multiplier" },
    "bankedAmount": { "$ref": "#/$defs/Amount" },
    "payout": { "description": "What the finished round credits the player, in base units: on won and lost only; 0 when nothing is credited. Computed by the server; never derived from a multiplier.", "$ref": "#/$defs/Amount" },
    "config": { "$ref": "#/$defs/GameConfig" },
    "proofs": { "$ref": "#/$defs/FairnessContext" }
  },
  "allOf": [
    {
      "$comment": "presentation selects the config shape. playback is book-model only: a config round has no table to play back.",
      "if": { "properties": { "presentation": { "const": "steps" } } },
      "then": { "properties": { "config": { "properties": { "kind": { "const": "steps" } } } } },
      "else": {
        "properties": {
          "model": { "const": "book" },
          "config": { "properties": { "kind": { "const": "book" } } }
        },
        "not": { "required": ["step"] }
      }
    },
    {
      "$comment": "playback status flow: a book round has no move and no player cancel, and its draw is recorded together with its won or lost status, so a client sees idle, starting (no proofs, then randomnessProof once bound), then won or lost. It is never active, resolving or canceled; a round voided or refused before its draw shows idle.",
      "if": { "properties": { "presentation": { "const": "playback" } } },
      "then": { "properties": { "status": { "not": { "enum": ["active", "resolving", "canceled"] } } } }
    },
    {
      "$comment": "idle: no round in front of the player, so no round-scoped fields. proofs is rejected at its own location only, so a proof served on idle (a round creation authorization included) is named where it sits, and once.",
      "if": { "properties": { "status": { "const": "idle" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["roundId"] },
            { "required": ["step"] },
            { "required": ["currentMultiplier"] },
            { "required": ["bankedAmount"] }
          ]
        },
        "properties": { "proofs": { "not": {} } }
      },
      "else": { "required": ["roundId"] }
    },
    {
      "$comment": "starting: no play has happened yet. Proofs fill in by preparation phase (Created: none; Bound, Funded: randomnessProof), so they are optional here and required from active on.",
      "if": { "properties": { "status": { "const": "starting" } } },
      "then": {
        "not": {
          "anyOf": [{ "required": ["step"] }, { "required": ["currentMultiplier"] }, { "required": ["bankedAmount"] }]
        }
      },
      "else": {
        "if": { "properties": { "status": { "enum": ["active", "resolving", "won", "lost", "canceled"] } } },
        "then": { "required": ["proofs"] }
      }
    },
    {
      "$comment": "Blindness: before a round is terminal no reveal, no draw, no close fields.",
      "if": { "properties": { "status": { "enum": ["idle", "starting", "active", "resolving"] } } },
      "then": {
        "not": { "required": ["closeReason"] },
        "properties": {
          "config": { "not": { "required": ["draw"] } },
          "proofs": {
            "properties": {
              "fairnessProof": { "not": { "required": ["seed"] } },
              "randomnessProof": { "not": { "required": ["roundSecret"] } }
            }
          }
        }
      }
    },
    {
      "$comment": "Blindness: before the first action no step carries a pick or a loser.",
      "if": { "properties": { "status": { "enum": ["idle", "starting"] } } },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "steps": {
                "items": {
                  "not": { "anyOf": [{ "required": ["selectedIndex"] }, { "required": ["losingIndex"] }] }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "Blindness: mid-round a loser is shown only for a step the player has played.",
      "if": { "properties": { "status": { "enum": ["active", "resolving"] } } },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "steps": { "items": { "dependentRequired": { "losingIndex": ["selectedIndex"] } } }
            }
          }
        }
      }
    },
    {
      "$comment": "Book rounds carry no fairness proof (no hidden configuration).",
      "if": { "properties": { "model": { "const": "book" } } },
      "then": { "properties": { "proofs": { "not": { "required": ["fairnessProof"] } } } }
    },
    {
      "$comment": "Round creation authorization: a config round's authorization is signed when the round is bound, with its randomness proof, so a config round's proofs always carry it (from the bind on: starting once bound, then every later status). A book round never carries it.",
      "if": { "properties": { "model": { "const": "config" } } },
      "then": { "properties": { "proofs": { "required": ["createRoundAuth"] } } },
      "else": { "properties": { "proofs": { "properties": { "createRoundAuth": { "not": {} } } } } }
    },
    {
      "$comment": "Config rounds derive the seed, and so publish its hash (seedHash), at Release, so the fairness proof is there from active on. A starting round may not have it yet.",
      "if": {
        "properties": {
          "model": { "const": "config" },
          "status": { "enum": ["active", "resolving", "won", "lost", "canceled"] }
        }
      },
      "then": { "properties": { "proofs": { "required": ["fairnessProof"] } } }
    },
    {
      "$comment": "steps presentation: progress and the multiplier are shown from active on.",
      "if": {
        "properties": {
          "presentation": { "const": "steps" },
          "status": { "enum": ["active", "resolving", "won", "lost"] }
        }
      },
      "then": { "required": ["step", "currentMultiplier"] }
    },
    {
      "$comment": "won and lost: the round secret is revealed when the round ends, so a finished round always carries it.",
      "if": { "properties": { "status": { "enum": ["won", "lost"] } } },
      "then": {
        "properties": { "proofs": { "properties": { "randomnessProof": { "required": ["roundSecret"] } } } }
      }
    },
    {
      "$comment": "won and lost, config model: the seed is revealed with the secret.",
      "if": {
        "properties": {
          "model": { "const": "config" },
          "status": { "enum": ["won", "lost"] }
        }
      },
      "then": {
        "properties": { "proofs": { "properties": { "fairnessProof": { "required": ["seed"] } } } }
      }
    },
    {
      "$comment": "A book draw is shown only on won and lost, never on canceled.",
      "if": { "properties": { "status": { "const": "canceled" } } },
      "then": { "properties": { "config": { "not": { "required": ["draw"] } } } }
    },
    {
      "$comment": "payout is what a finished round credits, so it is shown on won and lost only. A canceled round's bet is returned, not paid, so it carries none.",
      "if": { "properties": { "status": { "enum": ["idle", "starting", "active", "resolving", "canceled"] } } },
      "then": { "not": { "required": ["payout"] } }
    }
  ],
  "$defs": {
    "RoundStatus": {
      "description": "Round lifecycle phase. New values only behind a client capability flag. A playback (book) round shows idle, starting (no proofs, then randomnessProof once bound), then won or lost; never active, resolving or canceled.",
      "enum": ["idle", "starting", "active", "resolving", "won", "lost", "canceled"]
    },
    "RoundId": {
      "description": "UUIDv7, canonical lowercase text form.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RoundIdBytes32": {
      "description": "The roundId in its on-chain bytes32 form: the 16 UUIDv7 bytes left-aligned, zero-padded.",
      "type": "string",
      "pattern": "^0x[0-9a-f]{12}7[0-9a-f]{3}[89ab][0-9a-f]{15}0{32}$"
    },
    "Hash32": {
      "description": "32 bytes, 0x-prefixed lowercase hex.",
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "HttpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048
    },
    "BaseUnits": {
      "description": "Non-negative integer in the token's smallest unit, base-10, no sign, no leading zeros, at most 2^256-1. The pattern is the exact range: any value of up to 77 digits, or a 78-digit value not above 2^256-1 (115792089237316195423570985008687907853269984665640564039457584007913129639935).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,76}|10[0-9]{76}|11[0-4][0-9]{75}|115[0-6][0-9]{74}|1157[0-8][0-9]{73}|11579[0-1][0-9]{72}|1157920[0-7][0-9]{70}|11579208[0-8][0-9]{69}|115792089[0-1][0-9]{68}|1157920892[0-2][0-9]{67}|11579208923[0-6][0-9]{66}|115792089237[0-2][0-9]{65}|11579208923730[0-9]{64}|11579208923731[0-5][0-9]{63}|1157920892373160[0-9]{62}|1157920892373161[0-8][0-9]{61}|11579208923731619[0-4][0-9]{60}|115792089237316195[0-3][0-9]{59}|1157920892373161954[0-1][0-9]{58}|11579208923731619542[0-2][0-9]{57}|115792089237316195423[0-4][0-9]{56}|1157920892373161954235[0-6][0-9]{55}|115792089237316195423570[0-8][0-9]{53}|1157920892373161954235709[0-7][0-9]{52}|11579208923731619542357098[0-4][0-9]{51}|11579208923731619542357098500[0-7][0-9]{48}|115792089237316195423570985008[0-5][0-9]{47}|1157920892373161954235709850086[0-7][0-9]{46}|11579208923731619542357098500868[0-6][0-9]{45}|115792089237316195423570985008687[0-8][0-9]{44}|11579208923731619542357098500868790[0-6][0-9]{42}|115792089237316195423570985008687907[0-7][0-9]{41}|1157920892373161954235709850086879078[0-4][0-9]{40}|11579208923731619542357098500868790785[0-2][0-9]{39}|115792089237316195423570985008687907853[0-1][0-9]{38}|1157920892373161954235709850086879078532[0-5][0-9]{37}|11579208923731619542357098500868790785326[0-8][0-9]{36}|115792089237316195423570985008687907853269[0-8][0-9]{35}|1157920892373161954235709850086879078532699[0-7][0-9]{34}|11579208923731619542357098500868790785326998[0-3][0-9]{33}|115792089237316195423570985008687907853269984[0-5][0-9]{32}|1157920892373161954235709850086879078532699846[0-5][0-9]{31}|11579208923731619542357098500868790785326998466[0-4][0-9]{30}|115792089237316195423570985008687907853269984665[0-5][0-9]{29}|1157920892373161954235709850086879078532699846656[0-3][0-9]{28}|115792089237316195423570985008687907853269984665640[0-4][0-9]{26}|1157920892373161954235709850086879078532699846656405[0-5][0-9]{25}|11579208923731619542357098500868790785326998466564056[0-3][0-9]{24}|1157920892373161954235709850086879078532699846656405640[0-2][0-9]{22}|11579208923731619542357098500868790785326998466564056403[0-8][0-9]{21}|115792089237316195423570985008687907853269984665640564039[0-3][0-9]{20}|1157920892373161954235709850086879078532699846656405640394[0-4][0-9]{19}|11579208923731619542357098500868790785326998466564056403945[0-6][0-9]{18}|115792089237316195423570985008687907853269984665640564039457[0-4][0-9]{17}|1157920892373161954235709850086879078532699846656405640394575[0-7][0-9]{16}|11579208923731619542357098500868790785326998466564056403945758[0-3][0-9]{15}|11579208923731619542357098500868790785326998466564056403945758400[0-6][0-9]{12}|115792089237316195423570985008687907853269984665640564039457584007[0-8][0-9]{11}|11579208923731619542357098500868790785326998466564056403945758400790[0-9]{10}|11579208923731619542357098500868790785326998466564056403945758400791[0-2][0-9]{9}|1157920892373161954235709850086879078532699846656405640394575840079130[0-9]{8}|1157920892373161954235709850086879078532699846656405640394575840079131[0-1][0-9]{7}|11579208923731619542357098500868790785326998466564056403945758400791312[0-8][0-9]{6}|115792089237316195423570985008687907853269984665640564039457584007913129[0-5][0-9]{5}|1157920892373161954235709850086879078532699846656405640394575840079131296[0-2][0-9]{4}|11579208923731619542357098500868790785326998466564056403945758400791312963[0-8][0-9]{3}|115792089237316195423570985008687907853269984665640564039457584007913129639[0-8][0-9]{2}|1157920892373161954235709850086879078532699846656405640394575840079131296399[0-2][0-9]|11579208923731619542357098500868790785326998466564056403945758400791312963993[0-4]|115792089237316195423570985008687907853269984665640564039457584007913129639935)$",
      "maxLength": 78
    },
    "Unit": {
      "description": "Currency code from the engine's currency registry, e.g. EUR, ETH, USDT-TRON.",
      "type": "string",
      "pattern": "^[A-Z0-9]{2,10}(-[A-Z0-9]{2,10})?$"
    },
    "Multiplier": {
      "description": "Payout multiplier for display. Never used for money math; amounts come as Amount.",
      "type": "number",
      "minimum": 0
    },
    "Amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "decimals", "unit", "normalized", "formatted"],
      "properties": {
        "value": { "$ref": "#/$defs/BaseUnits" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 77 },
        "unit": { "$ref": "#/$defs/Unit" },
        "normalized": { "description": "Display-only number. Never used for money math.", "type": "number" },
        "formatted": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "AmountRequest": {
      "description": "An amount sent by the client. Only the money-bearing fields; normalized and formatted are response-only and rejected. decimals is optional and, when present, must equal the registry scale of unit (checked by the server, not by this schema).",
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "$ref": "#/$defs/BaseUnits" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 77 },
        "unit": { "$ref": "#/$defs/Unit" }
      }
    },
    "SessionContext": {
      "description": "Launch context. No player ID, no operator token.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "language", "device", "theme"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ses_[0-9A-Za-z]{1,64}$" },
        "language": { "description": "Lowercase ISO 639 code.", "type": "string", "pattern": "^[a-z]{2,3}$" },
        "country": { "description": "ISO 3166-1 alpha-2.", "type": "string", "pattern": "^[A-Z]{2}$" },
        "device": { "enum": ["desktop", "mobile"] },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lobby": { "$ref": "#/$defs/HttpsUrl" },
            "deposit": { "$ref": "#/$defs/HttpsUrl" }
          }
        },
        "theme": { "$ref": "#/$defs/Theme" },
        "view": {
          "description": "Personalization filled per the game's developer-defined schema. Opaque to the engine contract, except that no key may name a player identifier or an operator token (the same rule as SessionContext).",
          "type": "object",
          "not": {
            "anyOf": [
              { "required": ["playerId"] },
              { "required": ["player_id"] },
              { "required": ["userId"] },
              { "required": ["user_id"] },
              { "required": ["operatorPlayerId"] },
              { "required": ["operator_player_id"] },
              { "required": ["operatorToken"] },
              { "required": ["operator_token"] },
              { "required": ["token"] },
              { "required": ["accessToken"] },
              { "required": ["access_token"] }
            ]
          }
        }
      }
    },
    "Theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appearance": { "enum": ["dark", "light"] },
        "colorPalette": { "type": "object" },
        "tileStyles": { "type": "object" }
      }
    },
    "BetContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["balance", "minBet", "maxBet", "suggestedBets", "defaultBet"],
      "properties": {
        "balance": { "$ref": "#/$defs/Amount" },
        "minBet": { "$ref": "#/$defs/Amount" },
        "maxBet": { "$ref": "#/$defs/Amount" },
        "suggestedBets": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/Amount" } },
        "defaultBet": { "$ref": "#/$defs/Amount" }
      }
    },
    "GameConfig": {
      "description": "PUBLIC round configuration. Never contains unresolved outcomes.",
      "oneOf": [{ "$ref": "#/$defs/StepConfig" }, { "$ref": "#/$defs/BookConfig" }]
    },
    "StepConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "steps"],
      "properties": {
        "kind": { "const": "steps" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/Step" } }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "optionCount", "multiplier"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "optionCount": { "type": "integer", "minimum": 2 },
        "multiplier": { "$ref": "#/$defs/Multiplier" },
        "selectedIndex": { "description": "The player's pick, once they acted.", "type": "integer", "minimum": 0 },
        "losingIndex": {
          "description": "The losing option. Present only after this step (or the whole round) resolved.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "BookConfig": {
      "description": "playback presentation of a book game: its Stake package and mode, the mode's exact RTP, and, on won and lost only, the draw with the drawn book's events. A book round is idle, starting, then won or lost; never active, resolving or canceled. kind and model are fixed for the session.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "packageHash", "model"],
      "properties": {
        "kind": { "const": "book" },
        "packageHash": { "$ref": "#/$defs/Hash32" },
        "model": { "description": "Stake mode name from the package's index.json.", "type": "string", "minLength": 1, "maxLength": 64 },
        "rtp": { "$ref": "#/$defs/BookRtp" },
        "draw": { "$ref": "#/$defs/BookDraw" }
      }
    },
    "BookRtp": {
      "description": "The mode's exact return to player per unit wagered, computed from its table by the certifier (the signed verdict covers the package's RTP bound, not this value): shown before the first bet. Optional in /1 (added 2026-10-26); the server sends it on every book game whose version stores it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fraction", "decimal"],
      "properties": {
        "fraction": { "description": "The exact RTP, a reduced fraction of 1: \"n\" or \"n/d\" (\"24/25\"). The value to verify against.", "type": "string", "maxLength": 201, "pattern": "^(0|[1-9][0-9]{0,99})(/[1-9][0-9]{0,99})?$" },
        "decimal": { "description": "Display only: the fraction rounded down to 4 decimal places (\"0.9600\"). Never compute with it.", "type": "string", "pattern": "^(0\\.[0-9]{4}|1\\.0000)$" }
      }
    },
    "BookDraw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "payoutMultiplier", "events"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "payoutMultiplier": { "$ref": "#/$defs/Multiplier" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/BookEvent" } }
      }
    },
    "BookEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "type"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "data": { "description": "Shape defined by the math package." }
      }
    },
    "FairnessContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["randomnessProof"],
      "properties": {
        "fairnessProof": { "$ref": "#/$defs/FairnessProof" },
        "randomnessProof": { "$ref": "#/$defs/RandomnessProof" },
        "createRoundAuth": { "$ref": "#/$defs/CreateRoundAuth" },
        "record": { "$ref": "#/$defs/OnChainRecord" }
      }
    },
    "FairnessProof": {
      "description": "Config rounds only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["seedHash"],
      "properties": {
        "seedHash": { "$ref": "#/$defs/Hash32" },
        "readyHash": { "description": "T_0, the Ready evidence hash keccak256(abi.encode(created, seedHash)): the previous of the round's first signed action. Additive in /1.", "$ref": "#/$defs/Hash32" },
        "seed": { "description": "Revealed only after the round ends.", "$ref": "#/$defs/Hash32" },
        "zkProof": { "$ref": "#/$defs/ZKProofRef" }
      }
    },
    "RandomnessProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "blockNumber", "roundSecretHash"],
      "properties": {
        "source": { "description": "Entropy source identifier.", "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]{0,63}$" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "blockValue": { "$ref": "#/$defs/Hash32" },
        "blockExplorerUrl": { "$ref": "#/$defs/HttpsUrl" },
        "roundSecretHash": { "$ref": "#/$defs/Hash32" },
        "roundSecret": { "description": "Revealed only after the round ends.", "$ref": "#/$defs/Hash32" },
        "zkProof": { "$ref": "#/$defs/ZKProofRef" }
      }
    },
    "OnChainRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "roundId", "txHash"],
      "properties": {
        "chainId": { "type": "integer", "minimum": 1 },
        "roundId": { "$ref": "#/$defs/RoundIdBytes32" },
        "txHash": { "$ref": "#/$defs/Hash32" },
        "explorerUrl": { "$ref": "#/$defs/HttpsUrl" }
      }
    },
    "CreateRoundAuth": {
      "description": "Config rounds only, required from the bind on: the round creation authorization, an EIP-712 signature by the registry admin key over CreateRoundAuth(bytes32 created,uint40 prepareWindow,uint256 expiry), where created = keccak256(abi.encode(newRound)). The same object on every read of the round. domain and signer are the round's own values; a client trusts them only when they equal the values pinned in its own configuration.",
      "type": "object",
      "additionalProperties": false,
      "required": ["newRound", "entropyChainId", "prepareWindow", "expiry", "domain", "signer", "signature"],
      "properties": {
        "newRound": { "$ref": "#/$defs/NewRound" },
        "entropyChainId": {
          "description": "Chain of the entropy source. Not signed itself: with randomnessProof.source and blockNumber it recomputes newRound.randomnessTarget.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "prepareWindow": { "description": "The signed prepareWindow (uint40), in seconds.", "type": "integer", "minimum": 0, "maximum": 1099511627775 },
        "expiry": { "description": "The signed expiry (uint256), Unix seconds. It bounds when the registry accepts the authorization; a past expiry does not void the signature.", "$ref": "#/$defs/Uint256" },
        "domain": { "$ref": "#/$defs/RegistryDomain" },
        "signer": { "description": "The registry admin address that signed.", "$ref": "#/$defs/Address" },
        "signature": { "$ref": "#/$defs/Signature65" }
      }
    },
    "NewRound": {
      "description": "The signed round, field by field, in abi.encode order: 11 static words (352 bytes) whose keccak256 is created. Every word is needed to recompute created.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roundId",
        "playerRef",
        "currency",
        "betAmount",
        "gameId",
        "gameVersion",
        "circuitVersion",
        "roundSecretHash",
        "randomnessTarget",
        "actionKey",
        "payoutTermsHash"
      ],
      "properties": {
        "roundId": { "description": "The bytes32 form of the Snapshot's roundId.", "$ref": "#/$defs/RoundIdBytes32" },
        "playerRef": { "description": "The player's own pseudonym, the same in every round of that player. Not the player ID, and not reversible.", "$ref": "#/$defs/Hash32" },
        "currency": { "description": "The bet's currency code; as bytes32 it is ASCII, left-aligned, zero-padded.", "$ref": "#/$defs/Unit" },
        "betAmount": { "description": "The bet in base units (uint128).", "$ref": "#/$defs/Uint128" },
        "gameId": { "description": "uint32.", "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "gameVersion": { "description": "uint32.", "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "circuitVersion": { "description": "uint32.", "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "roundSecretHash": { "description": "Equals randomnessProof.roundSecretHash.", "$ref": "#/$defs/Hash32" },
        "randomnessTarget": { "description": "keccak256(abi.encode(bytes32 source, uint256 entropyChainId, uint256 blockNumber)), from randomnessProof; source as bytes32 is ASCII, left-aligned, zero-padded.", "$ref": "#/$defs/Hash32" },
        "actionKey": { "description": "The address the client signs the round's actions with.", "$ref": "#/$defs/Address" },
        "payoutTermsHash": { "description": "keccak256(abi.encode(PayoutTerms)) of the game's certified terms.", "$ref": "#/$defs/Hash32" }
      }
    },
    "RegistryDomain": {
      "description": "The EIP-712 domain of the round's registry, fixed when the round is bound.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "chainId", "verifyingContract"],
      "properties": {
        "name": { "const": "SuperEngine" },
        "version": { "const": "1" },
        "chainId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "verifyingContract": { "description": "The registry contract address.", "$ref": "#/$defs/Address" }
      }
    },
    "Address": {
      "description": "EVM address, 20 bytes, 0x-prefixed lowercase hex (no checksum casing; compare as bytes).",
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "Signature65": {
      "description": "secp256k1 signature r || s || v, 65 bytes, 0x-prefixed lowercase hex, v is 27 (1b) or 28 (1c). A low s is checked by the verifier, not by this pattern.",
      "type": "string",
      "pattern": "^0x[0-9a-f]{128}(1b|1c)$"
    },
    "Uint128": {
      "description": "Non-negative integer, base-10, no sign, no leading zeros, at most 2^128-1 (340282366920938463463374607431768211455). The pattern is the exact range.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37}|[1-2][0-9]{38}|3[0-3][0-9]{37}|340[0-1][0-9]{35}|3402[0-7][0-9]{34}|34028[0-1][0-9]{33}|340282[0-2][0-9]{32}|3402823[0-5][0-9]{31}|34028236[0-5][0-9]{30}|340282366[0-8][0-9]{29}|3402823669[0-1][0-9]{28}|340282366920[0-8][0-9]{26}|3402823669209[0-2][0-9]{25}|34028236692093[0-7][0-9]{24}|340282366920938[0-3][0-9]{23}|3402823669209384[0-5][0-9]{22}|34028236692093846[0-2][0-9]{21}|340282366920938463[0-3][0-9]{20}|3402823669209384634[0-5][0-9]{19}|34028236692093846346[0-2][0-9]{18}|340282366920938463463[0-2][0-9]{17}|3402823669209384634633[0-6][0-9]{16}|34028236692093846346337[0-3][0-9]{15}|340282366920938463463374[0-5][0-9]{14}|34028236692093846346337460[0-6][0-9]{12}|340282366920938463463374607[0-3][0-9]{11}|3402823669209384634633746074[0-2][0-9]{10}|340282366920938463463374607430[0-9]{9}|340282366920938463463374607431[0-6][0-9]{8}|3402823669209384634633746074317[0-5][0-9]{7}|34028236692093846346337460743176[0-7][0-9]{6}|340282366920938463463374607431768[0-1][0-9]{5}|34028236692093846346337460743176820[0-9]{4}|340282366920938463463374607431768210[0-9]{3}|340282366920938463463374607431768211[0-3][0-9]{2}|3402823669209384634633746074317682114[0-4][0-9]|34028236692093846346337460743176821145[0-4]|340282366920938463463374607431768211455)$",
      "maxLength": 39
    },
    "Uint256": {
      "description": "Non-negative integer that is not money, base-10, no sign, no leading zeros, at most 2^256-1: the grammar of BaseUnits.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,76}|10[0-9]{76}|11[0-4][0-9]{75}|115[0-6][0-9]{74}|1157[0-8][0-9]{73}|11579[0-1][0-9]{72}|1157920[0-7][0-9]{70}|11579208[0-8][0-9]{69}|115792089[0-1][0-9]{68}|1157920892[0-2][0-9]{67}|11579208923[0-6][0-9]{66}|115792089237[0-2][0-9]{65}|11579208923730[0-9]{64}|11579208923731[0-5][0-9]{63}|1157920892373160[0-9]{62}|1157920892373161[0-8][0-9]{61}|11579208923731619[0-4][0-9]{60}|115792089237316195[0-3][0-9]{59}|1157920892373161954[0-1][0-9]{58}|11579208923731619542[0-2][0-9]{57}|115792089237316195423[0-4][0-9]{56}|1157920892373161954235[0-6][0-9]{55}|115792089237316195423570[0-8][0-9]{53}|1157920892373161954235709[0-7][0-9]{52}|11579208923731619542357098[0-4][0-9]{51}|11579208923731619542357098500[0-7][0-9]{48}|115792089237316195423570985008[0-5][0-9]{47}|1157920892373161954235709850086[0-7][0-9]{46}|11579208923731619542357098500868[0-6][0-9]{45}|115792089237316195423570985008687[0-8][0-9]{44}|11579208923731619542357098500868790[0-6][0-9]{42}|115792089237316195423570985008687907[0-7][0-9]{41}|1157920892373161954235709850086879078[0-4][0-9]{40}|11579208923731619542357098500868790785[0-2][0-9]{39}|115792089237316195423570985008687907853[0-1][0-9]{38}|1157920892373161954235709850086879078532[0-5][0-9]{37}|11579208923731619542357098500868790785326[0-8][0-9]{36}|115792089237316195423570985008687907853269[0-8][0-9]{35}|1157920892373161954235709850086879078532699[0-7][0-9]{34}|11579208923731619542357098500868790785326998[0-3][0-9]{33}|115792089237316195423570985008687907853269984[0-5][0-9]{32}|1157920892373161954235709850086879078532699846[0-5][0-9]{31}|11579208923731619542357098500868790785326998466[0-4][0-9]{30}|115792089237316195423570985008687907853269984665[0-5][0-9]{29}|1157920892373161954235709850086879078532699846656[0-3][0-9]{28}|115792089237316195423570985008687907853269984665640[0-4][0-9]{26}|1157920892373161954235709850086879078532699846656405[0-5][0-9]{25}|11579208923731619542357098500868790785326998466564056[0-3][0-9]{24}|11579