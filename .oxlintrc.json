{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "oxc",
    "unicorn",
    "promise",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@superengine/contracts",
              "@superengine/contracts/**",
              "@superengine/signing",
              "@superengine/signing/**",
              "@superengine/snapshot",
              "@superengine/snapshot/**",
              "@superengine/play-client",
              "@superengine/play-client/**",
              "@superengine/shell",
              "@superengine/shell/**",
              "wrapper",
              "wrapper/**",
              "@superengine/wrapper",
              "@superengine/wrapper/**",
              "reference-game",
              "reference-game/**",
              "@superengine/reference-game",
              "@superengine/reference-game/**"
            ],
            "message": "dependency direction: contracts <- snapshot, play-client; signing, snapshot, play-client <- shell <- wrapper (specs/client-kit.md)"
          },
          {
            "group": [
              "@superengine/*/src",
              "@superengine/*/src/**",
              "@superengine/*/dist",
              "@superengine/*/dist/**"
            ],
            "message": "public entry points only (ADR-001)"
          },
          {
            "regex": "^(\\.\\./)+(contracts|signing|snapshot|play-client|shell|wrapper|reference-game|apps|packages)(/|$)",
            "message": "no relative import into another package (ADR-001)"
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "minimumDescriptionLength": 10
      }
    ],
    "eslint/no-eval": "error",
    "eslint/no-new-func": "error",
    "eslint/no-implied-eval": "error",
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "import/no-cycle": "error",
    "eslint/max-lines-per-function": "off",
    "unicorn/require-module-specifiers": "off",
    "eslint/default-case": "error",
    "eslint/object-shorthand": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-unmodified-loop-condition": "error",
    "eslint/no-alert": "error",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "includeExports": true
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true,
        "ts": true,
        "tsx": true,
        "json": true
      }
    ],
    "import/no-unassigned-import": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-non-null-assertion": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error"
  },
