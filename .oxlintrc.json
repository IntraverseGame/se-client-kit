{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "oxc",
    "unicorn",
    "promise",
    "node",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@intraverse/se-client-contracts",
              "@intraverse/se-client-contracts/**",
              "@intraverse/se-client-signing",
              "@intraverse/se-client-signing/**",
              "@intraverse/se-client-snapshot",
              "@intraverse/se-client-snapshot/**",
              "@intraverse/se-client-play-client",
              "@intraverse/se-client-play-client/**",
              "@intraverse/se-client-shell",
              "@intraverse/se-client-shell/**",
              "@intraverse/se-client-wrapper",
              "@intraverse/se-client-wrapper/**",
              "@intraverse/se-client-reference-game",
              "@intraverse/se-client-reference-game/**"
            ],
            "message": "dependency direction: contracts <- snapshot, play-client; signing, snapshot, play-client <- shell <- wrapper (specs/client-kit/packages.md)"
          },
          {
            "group": [
              "@intraverse/se-client-*/src",
              "@intraverse/se-client-*/src/**",
              "@intraverse/se-client-*/dist",
              "@intraverse/se-client-*/dist/**"
            ],
            "message": "public entry points only (ADR-001)"
          },
          {
            "regex": "^(\\.\\./)+(contracts|signing|snapshot|play-client|shell|wrapper|reference-game|apps|packages)(/|$)",
            "message": "no relative import into another package (ADR-001)"
          },
          {
            "group": ["@superengine", "@superengine/**"],
            "message": "the old working scope; use @intraverse/se-client-* (ADR-001)"
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "minimumDescriptionLength": 10
      }
    ],
    "eslint/no-eval": "error",
    "eslint/no-new-func": "error",
    "eslint/no-implied-eval": "error",
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "import/no-cycle": "error",
    "eslint/max-lines-per-function": "off",
    "eslint/default-case": "error",
    "eslint/object-shorthand": "error",
    "eslint/no-promise-executor-return": "error",
    "eslint/no-unmodified-loop-condition": "error",
    "eslint/no-alert": "error",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "includeExports": true
      }
    ],
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true,
        "ts": true,
        "tsx": true,
        "json": true
      }
    ],
    "import/no-unassigned-import": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-non-null-assertion": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "func-style": [
      "error",
      "expression",
      {
        "allowArrowFunctions": true
      }
    ],
    "prefer-arrow-callback": [
      "error",
      {
        "allowNamedFunctions": false
      }
    ]
  },
