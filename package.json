{
  "name": "se-client-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wireit",
    "build": "wireit",
    "lint": "wireit",
    "lint:ts": "wireit",
    "lint:css": "wireit",
    "format": "wireit",
    "format:check": "wireit",
    "typecheck": "wireit",
    "typecheck:tools": "wireit",
    "test": "wireit",
    "test:tools": "wireit",
    "test:e2e": "wireit",
    "check:deps": "wireit",
    "check:contracts": "wireit",
    "changeset": "changeset",
    "clean:cache": "find . -name .wireit -type d -not -path '*/node_modules/*' -prune -exec rm -rf {} +"
  },
  "wireit": {
    "check": {
      "dependencies": [
        "format:check",
        "lint",
        "typecheck",
        "test",
        "check:deps",
        "check:contracts"
      ]
    },
    "build": {
      "dependencies": [
        "./packages/contracts:build",
        "./packages/signing:build",
        "./packages/snapshot:build",
        "./packages/play-client:build",
        "./packages/shell:build",
        "./apps/wrapper:build",
        "./apps/reference-game:build"
      ]
    },
    "format": {
      "command": "oxfmt --write ."
    },
    "format:check": {
      "command": "oxfmt --check .",
      "files": [
        "**/*",
        "!**/.wireit/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        "!pnpm-lock.yaml"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint": {
      "dependencies": [
        "lint:ts",
        "lint:css"
      ]
    },
    "typecheck": {
      "dependencies": [
        "./packages/contracts:typecheck",
        "./packages/signing:typecheck",
        "./packages/snapshot:typecheck",
        "./packages/play-client:typecheck",
        "./packages/shell:typecheck",
        "./apps/wrapper:typecheck",
        "./apps/reference-game:typecheck",
        "./e2e:typecheck",
        "typecheck:tools"
      ]
    },
    "typecheck:tools": {
      "command": "tsc -p tsconfig.json",
      "files": [
        "tools/**",
        "vitest.config.ts",
        "tsconfig.base.json",
        "tsconfig.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "test": {
      "dependencies": [
        "./apps/wrapper:test",
        "test:tools"
      ]
    },
    "test:tools": {
      "command": "vitest run",
      "files": [
        "tools/**",
        "vitest.config.ts",
        ".oxlintrc.json",
        "decisions/ADR-001-toolchain-and-signing.md",
        "tsconfig.base.json",
        "tsconfig.json",
        "stylelint.config.mjs"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "test:e2e": {
      "dependencies": [
        "./e2e:test"
      ]
    },
    "check:deps": {
      "command": "tsx tools/check-dependency-allowlist.ts",
      "files": [
        "**/package.json",
        "tools/**",
        "pnpm-workspace.yaml",
        "!**/dist/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "check:contracts": {
      "command": "tsx tools/check-contracts.ts",
      "files": [
        "**/*.{ts,mts,cts,tsx,js,mjs,cjs}",
        "!**/dist/**",
        "tools/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint:ts": {
      "command": "oxlint -c .oxlintrc.json packages apps e2e tools vitest.config.ts",
      "files": [
        "**/*.{ts,mts,cts,tsx,js,mjs,cjs}",
        "!**/dist/**",
        ".oxlintrc.json",
        "**/tsconfig*.json",
        "**/package.json",
        ".gitignore"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint:css": {
      "command": "stylelint --allow-empty-input --ignore-path .gitignore \"**/*.css\"",
      "files": [
        "**/*.css",
        "!**/dist/**",
        "!**/.wireit/**",
        "!**/node_modules/**",
        "stylelint.config.mjs",
        ".gitignore"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.1",
    "jsdom": "30.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "stylelint": "17.16.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wireit": "0.14.13"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
