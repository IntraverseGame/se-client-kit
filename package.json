{
  "name": "se-client-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "wireit",
    "build": "wireit",
    "lint": "wireit",
    "lint:ts": "wireit",
    "lint:css": "wireit",
    "format": "wireit",
    "format:check": "wireit",
    "typecheck": "wireit",
    "typecheck:tools": "wireit",
    "test": "wireit",
    "test:tools": "wireit",
    "test:e2e": "wireit",
    "test:e2e:preview": "wireit",
    "check:deps": "wireit",
    "check:contracts": "wireit",
    "changeset": "changeset",
    "clean:cache": "find . -name .wireit -type d -not -path '*/node_modules/*' -prune -exec rm -rf {} +",
    "check:build-output": "wireit",
    "check:package-files": "wireit",
    "check:size-budget": "wireit",
    "check:readmes": "wireit",
    "release:dry-run": "wireit"
  },
  "wireit": {
    "check": {
      "dependencies": [
        "format:check",
        "lint",
        "typecheck",
        "test",
        "check:deps",
        "check:contracts",
        "check:build-output",
        "check:package-files",
        "check:size-budget",
        "check:readmes"
      ]
    },
    "build": {
      "dependencies": [
        "./packages/contracts:build",
        "./packages/signing:build",
        "./packages/snapshot:build",
        "./packages/play-client:build",
        "./packages/shell:build",
        "./apps/wrapper:build",
        "./apps/verify:build",
        "./apps/reference-game:build"
      ]
    },
    "format": {
      "command": "oxfmt --write ."
    },
    "format:check": {
      "command": "oxfmt --check .",
      "files": [
        "**/*",
        "!**/.wireit/**",
        "!**/node_modules/**",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        "!pnpm-lock.yaml"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint": {
      "dependencies": [
        "lint:ts",
        "lint:css"
      ]
    },
    "typecheck": {
      "dependencies": [
        "./packages/contracts:typecheck",
        "./packages/signing:typecheck",
        "./packages/snapshot:typecheck",
        "./packages/play-client:typecheck",
        "./packages/shell:typecheck",
        "./apps/wrapper:typecheck",
        "./apps/reference-game:typecheck",
        "./apps/verify:typecheck",
        "./e2e:typecheck",
        "typecheck:tools"
      ]
    },
    "typecheck:tools": {
      "command": "tsc -p tsconfig.json",
      "files": [
        "tools/**",
        "vitest.config.ts",
        "vitest.readmes.config.ts",
        "tsdown.base.ts",
        "packages/*/tsdown.config.ts",
        "apps/*/tsdown.config.ts",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json",
        "packages/*/package.json",
        "apps/*/package.json",
        "e2e/package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "test": {
      "dependencies": [
        "./packages/signing:test",
        "./apps/wrapper:test",
        "./apps/reference-game:test",
        "./apps/verify:test",
        "./packages/snapshot:test",
        "./packages/play-client:test",
        "./packages/shell:test",
        "test:tools",
        "check:readmes"
      ]
    },
    "test:tools": {
      "command": "vitest run",
      "dependencies": [
        "./packages/contracts:build",
        "./packages/signing:build",
        "./packages/shell:build"
      ],
      "files": [
        "tools/**",
        "vitest.config.ts",
        "tsdown.base.ts",
        ".oxlintrc.json",
        "stylelint.config.mjs",
        ".gitignore",
        ".changeset/config.json",
        ".github/workflows/release.yml",
        ".github/workflows/ci.yml",
        "tsconfig.json",
        "tsconfig.base.json",
        "package.json",
        "pnpm-workspace.yaml",
        "packages/*/package.json",
        "apps/*/package.json",
        "e2e/package.json",
        "packages/*/README.md",
        "apps/*/README.md",
        "specs/**/*.md",
        "decisions/**",
        "CONTRIBUTING.md",
        "README.md",
        "runbook/**",
        "packages/*/**",
        "apps/*/**",
        "e2e/**",
        "!**/dist/**",
        "!**/node_modules/**",
        "!**/.wireit/**",
        "!**/coverage/**",
        "!**/test-results/**",
        "!**/playwright-report/**",
        "!**/*.tsbuildinfo"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "test:e2e": {
      "dependencies": [
        "./e2e:test"
      ]
    },
    "test:e2e:preview": {
      "dependencies": [
        "./e2e:test:preview"
      ]
    },
    "check:deps": {
      "command": "tsx tools/check-dependency-allowlist.ts",
      "files": [
        "**/package.json",
        "pnpm-workspace.yaml",
        "tools/**",
        "tsconfig.json",
        "tsconfig.base.json",
        "!**/dist/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "check:contracts": {
      "command": "tsx tools/check-contracts.ts",
      "files": [
        "**/*.{ts,mts,cts,tsx,js,mjs,cjs,jsx,cjsx,mjsx,ctsx,mtsx}",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        "tools/**",
        "packages/contracts/contracts.lock.json",
        "packages/contracts/src/**",
        "package.json",
        "tsconfig.json",
        "tsconfig.base.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint:ts": {
      "command": "oxlint -c .oxlintrc.json packages apps e2e tools vitest.config.ts vitest.readmes.config.ts",
      "dependencies": [
        "./packages/contracts:build",
        "./packages/signing:build",
        "./packages/snapshot:build",
        "./packages/play-client:build",
        "./packages/shell:build"
      ],
      "files": [
        "**/*.{ts,mts,cts,tsx,js,mjs,cjs,jsx,cjsx,mjsx,ctsx,mtsx}",
        "**/*.json",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        ".oxlintrc.json",
        "**/.gitignore"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "lint:css": {
      "command": "stylelint --allow-empty-input --ignore-path .gitignore \"**/*.css\"",
      "files": [
        "**/*.css",
        "!**/dist/**",
        "!**/coverage/**",
        "!**/playwright-report/**",
        "!**/test-results/**",
        "!**/.wireit/**",
        "!**/node_modules/**",
        "stylelint.config.mjs",
        "**/stylelint.config.*",
        "**/.stylelintrc*",
        ".stylelintignore",
        "**/.gitignore",
        "**/package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "check:build-output": {
      "command": "tsx tools/check-build-output.ts",
      "dependencies": [
        "build"
      ],
      "files": [
        "tools/**",
        "!tools/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.base.json",
        "packages/*/package.json",
        "apps/*/package.json",
        "packages/contracts/src/**",
        "packages/*/dist/**",
        "apps/*/dist/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "check:package-files": {
      "command": "tsx tools/check-package-files.ts",
      "dependencies": [
        "./packages/contracts:build",
        "./packages/signing:build",
        "./packages/snapshot:build",
        "./packages/play-client:build",
        "./packages/shell:build"
      ],
      "files": [
        "tools/**",
        "!tools/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.base.json",
        "packages/*/package.json",
        "packages/*/dist/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "check:size-budget": {
      "command": "tsx tools/check-size-budget.ts",
      "dependencies": [
        "./apps/wrapper:build"
      ],
      "files": [
        "tools/**",
        "!tools/**/*.test.ts",
        "package.json",
        "tsconfig.json",
        "tsconfig.base.json",
        "apps/wrapper/package.json",
        "apps/wrapper/dist/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "check:readmes": {
      "command": "vitest run --config vitest.readmes.config.ts"
    },
    "release:dry-run": {
      "command": "tsx tools/release-dry-run.ts"
    }
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "jsdom": "30.1.2",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "6.7.6",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "stylelint": "17.16.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wireit": "0.14.13"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
